# Use /api with the Vite development proxy, or set an absolute backend URL for deployment.
VITE_API_URL=/api

# Firebase web configuration (optional until Firebase Auth is enabled)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
