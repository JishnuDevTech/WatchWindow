# Database
DATABASE_URL=postgresql://watchwindow:change-me@localhost:5432/watchwindow

# API
API_TITLE=WatchWindow API
API_VERSION=0.1.0
API_DESCRIPTION=Shared household TV scheduling platform

# CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Firebase Admin credentials (optional; never commit real values)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=

# Environment
ENVIRONMENT=development
DEBUG=True
